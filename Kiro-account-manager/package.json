{
  "name": "kiro-account-manager",
  "version": "1.7.7",
  "description": "Kiro Account Manager - Manage your Kiro accounts, usage and subscriptions",
  "main": "./out/main/index.js",
  "author": "Kiro",
  "license": "AGPL-3.0",
  "homepage": "https://kiro.dev",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "build:service": "node scripts/build-service.mjs",
    "service": "node out/service/index.cjs",
    "dev": "chcp 65001 >nul && electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "test:e2e": "node test/e2e-fullsuite/run.mjs",
    "test:e2e:only": "node test/e2e-fullsuite/run.mjs --only",
    "test:proxy": "node test/verify-effort.mjs && node test/verify-effort-capability.mjs && node test/verify-effort-budget.mjs && node test/probe-tools.mjs && node test/verify-webtools.mjs && node test/verify-webtools-http.mjs && node test/verify-account-pool-sync.mjs && node test/verify-eventstream-parser.mjs && node test/verify-prompt-cache.mjs && node test/verify-logger-overhead.mjs && node test/verify-stream-start-overlap.mjs && node test/verify-token-memo.mjs && node test/verify-context-1m.mjs && node test/verify-model-mapping.mjs && node test/verify-apikey-billing.mjs && node test/verify-resilience.mjs && node test/verify-admin-gate.mjs && node test/verify-payload-trim-perf.mjs && node test/verify-effort-variants.mjs && node test/verify-portal-getting-started.mjs",
    "test:portal": "node test/verify-portal.mjs && node test/verify-google-invite.mjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@tailwindcss/vite": "^4.1.17",
    "@tanstack/react-virtual": "^3.13.12",
    "cbor-x": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.3.9",
    "framer-motion": "^12.40.0",
    "js-tiktoken": "^1.0.21",
    "lucide-react": "^0.555.0",
    "node-forge": "^1.3.3",
    "socks": "^2.8.9",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.17",
    "tlsclientwrapper": "^4.2.0",
    "undici": "^7.19.2",
    "uuid": "^13.0.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^22.18.6",
    "@types/node-forge": "^1.3.14",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.0.3",
    "electron": "^38.1.2",
    "electron-builder": "^25.1.8",
    "electron-vite": "^4.0.1",
    "eslint": "^9.36.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "prettier": "^3.6.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.6"
  }
}
